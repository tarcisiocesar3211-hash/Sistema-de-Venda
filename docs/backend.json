{
  "entities": {
    "Client": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Client",
      "type": "object",
      "description": "Represents a client in the sales system.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the client."
        },
        "ownerId": {
            "type": "string",
            "description": "The UID of the user who owns this client."
        },
        "name": {
          "type": "string",
          "description": "The full name of the client."
        },
        "email": {
          "type": "string",
          "description": "The email address of the client.",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "description": "The phone number of the client."
        },
        "planId": {
          "type": "string"
        },
        "dueDate": {
            "type": "string",
            "format": "date-time"
        },
        "tela": {
            "type": "string"
        },
        "pin": {
            "type": "string"
        },
        "suporte": {
            "type": "boolean"
        },
        "observacao": {
            "type": "string"
        },
        "createdAt": {
          "type": "string",
          "description": "The date and time when the client was created.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "name",
        "email",
        "phone",
        "planId",
        "dueDate"
      ]
    },
    "Plan": {
      "title": "Plan",
      "type": "object",
      "description": "Represents a subscription plan.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "price": {
          "type": "string"
        }
      },
      "required": ["id", "name", "price"]
    },
    "Account": {
      "title": "Account",
      "type": "object",
      "description": "Represents a stock account.",
       "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "email": { "type": "string" },
        "senha": { "type": "string" },
        "tela": { "type": "string" },
        "pin": { "type": "string" },
        "remetente": { "type": "string" },
        "categoria": { "type": "string" },
        "status": { "type": "string", "enum": ["Disponivel", "Vendido", "Estoque", "Caida", "Pagamento"] },
        "observacao": { "type": "string" }
      },
      "required": ["id", "ownerId", "email", "senha", "categoria", "status"]
    },
    "Payment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Payment",
      "type": "object",
      "description": "Represents a payment made by a client.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the payment."
        },
        "ownerId": {
            "type": "string"
        },
        "clientId": {
          "type": "string",
          "description": "Reference to Client. (Relationship: Client 1:N Payment)"
        },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "amount": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "clientId",
        "clientName",
        "clientEmail",
        "amount",
        "date"
      ]
    },
    "Invoice": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Invoice",
      "type": "object",
      "description": "Represents an invoice issued to a client.",
      "properties": {
        "invoice": {
          "type": "string",
          "description": "Unique identifier for the invoice."
        },
        "ownerId": {
            "type": "string"
        },
        "clientName": {
          "type": "string"
        },
        "parcela": {
            "type": "string"
        },
        "amount": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "description": "The status of the invoice (e.g., sent, paid, overdue)."
        },
        "dueDate": {
          "type": "string",
          "description": "The date the invoice is due.",
          "format": "date-time"
        }
      },
      "required": [
        "invoice",
        "ownerId",
        "clientName",
        "amount",
        "status",
        "dueDate"
      ]
    },
    "Annotation": {
      "title": "Annotation",
      "type": "object",
      "description": "Represents a user-created note or annotation.",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "done"] }
      },
      "required": ["id", "ownerId", "title", "text", "status"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}/clients/{clientId}",
        "definition": {
          "entityName": "Client",
          "schema": {
            "$ref": "#/backend/entities/Client"
          }
        }
      },
       {
        "path": "/users/{userId}/accounts/{accountId}",
        "definition": {
          "entityName": "Account",
          "schema": {
            "$ref": "#/backend/entities/Account"
          }
        }
      },
      {
        "path": "/users/{userId}/payments/{paymentId}",
        "definition": {
          "entityName": "Payment",
          "schema": {
            "$ref": "#/backend/entities/Payment"
          }
        }
      },
      {
        "path": "/users/{userId}/invoices/{invoiceId}",
        "definition": {
          "entityName": "Invoice",
          "schema": {
            "$ref": "#/backend/entities/Invoice"
          }
        }
      },
      {
          "path": "/plans/{planId}",
          "definition": {
              "entityName": "Plan",
              "schema": {
                  "$ref": "#/backend/entities/Plan"
              }
          }
      },
      {
        "path": "/users/{userId}/annotations/{annotationId}",
        "definition": {
          "entityName": "Annotation",
          "schema": {
            "$ref": "#/backend/entities/Annotation"
          }
        }
      }
    ]
  }
}
